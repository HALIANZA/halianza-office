{
  "name": "halianza-office",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @halianza/desktop",
    "build": "npm run build --workspace @halianza/desktop",
    "preview": "npm run preview --workspace @halianza/desktop",
    "tauri": "npm run tauri --workspace @halianza/desktop --",
    "format": "npm run format --workspaces --if-present",
    "format:check": "npm run format:check --workspaces --if-present"
  }
}
